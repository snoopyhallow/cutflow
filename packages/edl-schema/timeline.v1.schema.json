{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutflow.dev/schemas/timeline.v1.schema.json",
  "title": "TimelineProject",
  "description": "Canonical non-destructive Edit Decision List (EDL v1) shared between CutFlow web NLE, AI Co-Editor, and FFmpeg compiler.",
  "type": "object",
  "required": ["schemaVersion", "projectId", "sourceId", "output", "tracks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "profileId": { "type": ["string", "null"], "default": null },
    "title": { "type": "string", "default": "" },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "exported", "posted", "archived"],
      "default": "draft"
    },
    "sourceDurationMs": { "type": "integer", "minimum": 0, "default": 0 },
    "sourceWidth": { "type": "integer", "minimum": 2, "default": 1920 },
    "sourceHeight": { "type": "integer", "minimum": 2, "default": 1080 },
    "output": {
      "type": "object",
      "required": ["ratio", "quality", "speedPreset", "fps", "loudnessLufs"],
      "additionalProperties": false,
      "properties": {
        "ratio": { "type": "string", "enum": ["9:16", "4:5", "1:1", "16:9"] },
        "quality": { "type": "string", "enum": ["720p", "1080p", "1440p", "4k"] },
        "speedPreset": { "type": "string", "enum": ["draft", "final"] },
        "fps": { "type": "integer", "minimum": 15, "maximum": 120 },
        "loudnessLufs": { "type": "number", "minimum": -36, "maximum": -5 },
        "borderStyle": {
          "type": "string",
          "enum": ["none", "thin_rounded", "double_cinema"],
          "default": "none"
        },
        "cinemaGrade": {
          "type": "string",
          "enum": ["off", "crisp_hd"],
          "default": "off"
        }
      }
    },
    "tracks": {
      "type": "object",
      "required": ["video", "audio", "subtitles", "overlays"],
      "additionalProperties": false,
      "properties": {
        "video": {
          "type": "object",
          "required": ["clips", "framing"],
          "additionalProperties": false,
          "properties": {
            "coldOpen": {
              "type": ["object", "null"],
              "default": null,
              "required": ["enabled", "sourceStartMs", "durationMs"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "sourceStartMs": { "type": "integer", "minimum": 0 },
                "durationMs": { "type": "integer", "minimum": 500, "maximum": 4000 },
                "fadeOutMs": { "type": "integer", "minimum": 0, "maximum": 500, "default": 120 }
              }
            },
            "clips": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "sourceStartMs", "sourceEndMs"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sourceStartMs": { "type": "integer", "minimum": 0 },
                  "sourceEndMs": { "type": "integer", "minimum": 1 },
                  "sourceId": { "type": ["string", "null"], "default": null },
                  "label": { "type": "string", "default": "" },
                  "transitionIn": {
                    "type": "string",
                    "enum": ["none", "flash_white", "dip_black", "dissolve"],
                    "default": "none"
                  },
                  "transitionDurationMs": {
                    "type": "integer",
                    "minimum": 80,
                    "maximum": 800,
                    "default": 220
                  },
                  "transitionSfx": {
                    "type": "string",
                    "enum": ["none", "whoosh_flash", "cinema_hit"],
                    "default": "none"
                  }
                }
              }
            },
            "framing": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "timelineStartMs", "timelineEndMs", "mode"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "timelineStartMs": { "type": "integer", "minimum": 0 },
                  "timelineEndMs": { "type": "integer", "minimum": 1 },
                  "mode": { "type": "string", "enum": ["split", "fit", "centre", "crop"] },
                  "splitRatio": { "type": "number", "minimum": 0.2, "maximum": 0.65, "default": 0.35 },
                  "camBox": { "$ref": "#/$defs/normalizedBox" },
                  "gameBox": { "$ref": "#/$defs/normalizedBox" },
                  "fitBackdrop": {
                    "type": "string",
                    "enum": ["blur", "black"],
                    "default": "blur"
                  },
                  "panX": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
                  "panY": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
                  "zoom": { "type": "number", "minimum": 1.0, "maximum": 2.5, "default": 1.0 },
                  "sourceCropBox": { "$ref": "#/$defs/normalizedBox" }
                }
              }
            }
          }
        },
        "audio": {
          "type": "object",
          "required": ["gainDb", "normalizeLufs"],
          "additionalProperties": false,
          "properties": {
            "gainDb": { "type": "number", "minimum": -24, "maximum": 24, "default": 0 },
            "normalizeLufs": { "type": "number", "minimum": -36, "maximum": -5, "default": -14 },
            "dialogueEnhance": { "type": "boolean", "default": false },
            "muteOriginal": { "type": "boolean", "default": false },
            "bgm": {
              "type": ["object", "null"],
              "default": null,
              "additionalProperties": false,
              "properties": {
                "assetId": { "type": "string" },
                "gainDb": { "type": "number", "minimum": -48, "maximum": 12, "default": -16 },
                "duckingEnabled": { "type": "boolean", "default": true },
                "startOffsetMs": { "type": "integer", "minimum": 0, "default": 0 },
                "fadeInMs": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 500 },
                "fadeOutMs": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 1000 }
              }
            }
          }
        },
        "subtitles": {
          "type": "object",
          "required": ["enabled", "style", "censorProfanity", "marginVRatio", "muteRanges", "words"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "style": {
              "type": "object",
              "required": ["preset", "revealMode", "font", "fontSizeScale", "primaryColor", "accentColor", "outlineColor"],
              "additionalProperties": false,
              "properties": {
                "preset": {
                  "type": "string",
                  "enum": [
                    "bold_pop",
                    "karaoke_fill",
                    "clean_lower",
                    "boxed",
                    "cinema_neon_glow",
                    "viral_punch_glow"
                  ]
                },
                "revealMode": { "type": "string", "enum": ["group", "progressive", "single_word"] },
                "font": { "type": "string", "minLength": 1 },
                "fontSizeScale": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
                "primaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "outlineColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "letterSpacing": { "type": "number", "minimum": 0, "maximum": 12, "default": 0 },
                "colorPalette": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "default": []
                }
              }
            },
            "censorProfanity": { "type": "boolean" },
            "marginVRatio": { "type": "number", "minimum": 0.05, "maximum": 0.85 },
            "muteRanges": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "integer", "minimum": 1 }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "text", "startMs", "endMs"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 },
                  "startMs": { "type": "integer", "minimum": 0 },
                  "endMs": { "type": "integer", "minimum": 1 },
                  "speaker": { "type": ["string", "null"], "default": null },
                  "glowColor": {
                    "type": ["string", "null"],
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "default": null
                  }
                }
              }
            }
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "text", "startMs", "endMs"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": [
                  "seam_card_white",
                  "hook_banner_dark",
                  "cta_pill",
                  "pov_top_bar",
                  "watermark_tag",
                  "cinema_credit"
                ]
              },
              "text": { "type": "string" },
              "startMs": { "type": "integer", "minimum": 0 },
              "endMs": { "type": "integer", "minimum": 1 },
              "yAnchor": { "type": "string", "enum": ["split_seam", "top", "bottom"], "default": "split_seam" },
              "yOffsetRatio": { "type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0.0 },
              "xOffsetRatio": { "type": "number", "minimum": -0.5, "maximum": 0.5, "default": 0.0 },
              "opacity": { "type": "number", "minimum": 0.1, "maximum": 1.0, "default": 1.0 },
              "maxLines": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "normalizedBox": {
      "type": ["object", "null"],
      "default": null,
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0.05, "maximum": 1 },
        "h": { "type": "number", "minimum": 0.05, "maximum": 1 }
      }
    }
  }
}
